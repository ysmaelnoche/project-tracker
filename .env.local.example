# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by trusted server code (migrations, admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub (optional, enables repository/commit/PR visibility) ---
# A fine-grained personal access token with read-only access (Contents, Metadata,
# Pull requests, Checks) to the repos you want to connect. Server-only — never
# exposed to the client.
# Optional: you can instead (or additionally) paste a token into Config -> GitHub
# Connection in the running app — a database-stored token always takes priority
# over this one when both are set. This env var is the fallback / zero-setup path.
GITHUB_TOKEN=
