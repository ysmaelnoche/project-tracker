# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by trusted server code (migrations, admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub (optional, enables repository/commit/PR visibility) ---
# A fine-grained personal access token with read-only access (Contents, Metadata,
# Pull requests) to the repos you want to connect. Server-only — never exposed to the client.
GITHUB_TOKEN=
